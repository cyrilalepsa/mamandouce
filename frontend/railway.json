{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "yarn install --ignore-engines && yarn build",
    "nixpacksPlan": {
      "providers": ["node"],
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs-20_x", "yarn"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npx serve -s build -l $PORT"
  }
}
