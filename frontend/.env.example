# MamanDouce frontend (Vite) — copier vers .env
# cp frontend/.env.example frontend/.env

# URL de l'API. Prod NeriaCorp : Worker central https://api.neriacorp.com
# Si vide ou localhost alors que le front est servi sur
# mamandouce.neriacorp.com, le runtime bascule vers l'API N2.
# VITE_API_URL est un alias accepté.
# VITE_BACKEND_URL=https://api.neriacorp.com
VITE_BACKEND_URL=http://localhost:8000

# Cloudinary — lecture publique (pas de secrets).
# Priorité : VITE_CLOUDINARY_CLOUD_NAME, sinon GET /api/neriacorp/media
# (injecté côté serveur via CLOUDINARY_CLOUD_NAME, sans rebuild FE).
# Laisser vide en local = images /assets/fetus/ jusqu'à hydratation.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_FETUS_FOLDER=mamandouce/fetus
VITE_CLOUDINARY_TRANSFORMS=f_auto,q_auto
