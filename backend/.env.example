# MamanDouce API — copier vers .env (ne jamais committer .env)
# cp backend/.env.example backend/.env

# --- Core (requis en production) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=mamandouce
SECRET_KEY=change-me-long-random-string
ADMIN_SECRET=change-me-admin-secret
ADMIN_EMAIL=admin@example.com
FRONTEND_URL=http://localhost:5173
# Origines extra (les domaines NeriaCorp sont déjà fusionnés dans le code)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Portail NeriaCorp (zone B2C) ---
PUBLIC_APP_URL=https://mamandouce.app
PUBLIC_API_URL=https://api.mamandouce.app
NERIACORP_PORTAL_URL=https://neriacorp.com
NERIACORP_PORTAL_STATUS=active
NERIACORP_PORTAL_SORT=10

# --- Paiements Stripe ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_POSTPARTUM=

# --- Email (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# --- IA locale (OPTIONNEL — Option A : l'OCR passe par le Worker N2) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_COMPLEX_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# --- Push VAPID ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@example.com

# --- Cloudinary (upload fœtus — secrets serveur uniquement) ---
# Injecter CLOUD_NAME + API_KEY + API_SECRET puis :
#   python scripts/upload_fetus_cloudinary.py
# Le cloud_name public est aussi exposé sur GET /api/neriacorp/media (pas de secret).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FETUS_FOLDER=mamandouce/fetus
CLOUDINARY_TRANSFORMS=f_auto,q_auto

# --- Option A : API centralisée Noyau N2 ---
# Défaut code = https://api.neriacorp.com même si cette ligne est absente.
# Noyau local : N2_OCR_BASE_URL=http://127.0.0.1:8080
# Désactiver le relais (fallback OpenAI) : N2_OCR_BASE_URL=off
N2_OCR_BASE_URL=https://api.neriacorp.com
N2_OCR_API_KEY=
# N2_OCR_API_STYLE=n2-core   # défaut si host = api.neriacorp.com
# N2_OCR_API_STYLE=legacy    # JSON /ocr/analyze* (noyau local)
GEMINI_API_KEY=

# --- SSO portail NeriaCorp ---
# GET /api/neriacorp/sso/status expose toujours le handoff session (authorize/token/jwks)
# vers le Worker. sso_enabled=true seulement si ISSUER + LOGIN_URL sont tous les deux posés.
NERIACORP_SSO_ISSUER=
NERIACORP_SSO_LOGIN_URL=
NERIACORP_SSO_CALLBACK_URL=
NERIACORP_SSO_CLIENT_ID=mamandouce
# Prod (OAuth N2 Core) :
# NERIACORP_SSO_ISSUER=https://api.neriacorp.com
# NERIACORP_SSO_LOGIN_URL=https://api.neriacorp.com/api/auth/oauth/google/start
# NERIACORP_SSO_CALLBACK_URL=https://mamandouce.app/auth
# Publish live vers les apps sœurs (adapters.py)
AEVIS_BASE_URL=
AEVIS_API_KEY=
# VISATRACE_BASE_URL=
# VISATRACE_API_KEY=
# HERITIA_BASE_URL=
# HERITIA_API_KEY=
# VEOVISION_BASE_URL=
# VEOVISION_API_KEY=
# VELLUMIA_BASE_URL=
# VELLUMIA_API_KEY=

# --- Divers ---
DEBUG=false
LOW_MEMORY_MODE=true
PORT=8000
# STORE_REVIEW_EMAIL=review@apple.com
# IS_CAMOUFLAGE_ACTIVE=true
# ADMIN_DASHBOARD_URL=https://mamandouce.app/admin
