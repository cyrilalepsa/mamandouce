# MamanDouce API — copier vers .env (ne jamais committer .env)
# cp backend/.env.example backend/.env

# --- N2-Vault (requis en production — secrets Empire en RAM, jamais sur disque) ---
# POST https://api.neriacorp.com/api/v1/vault/sync
# Injecte GEMINI_*, CLOUDINARY_*, MONGO_URL, SSO, … dans os.environ au boot.
NERIACORP_MASTER_KEY=
# N2_VAULT_BASE_URL=https://api.neriacorp.com
# N2_VAULT_APP_ID=mamandouce
# N2_VAULT_PLANET=mamandouce
# Local / tests sans coffre : N2_VAULT_SYNC=off (les variables ci-dessous restent le fallback)
# N2_VAULT_SYNC=off

# --- Core (requis en production ; fournis par le Vault ou le process) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=mamandouce
SECRET_KEY=change-me-long-random-string
ADMIN_SECRET=change-me-admin-secret
# Les superadmins permanents (dashboard + premium) sont hardcodés :
# cyrilalepsa@gmail.com et superadmin@neriacorp.com
# (admin@example.com n'accorde aucun droit).
ADMIN_EMAIL=admin@example.com
# Local : Vite. En production : https://mamandouce.neriacorp.com
# Les URLs localhost / 127.0.0.1 sont ignorées par app_public_url()
# (liens reset-password, e-mails).
FRONTEND_URL=http://localhost:5173
# Origines extra CSV (ALLOWED_ORIGINS accepté). NeriaCorp + FRONTEND_URL + PUBLIC_APP_URL
# sont déjà fusionnés. Regex : https://{slug}.neriacorp.com (boutiques B2B).
# CORS_ORIGINS=https://mamandouce.neriacorp.com,https://mamandouce.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Portail NeriaCorp (zone B2C) ---
PUBLIC_APP_URL=https://mamandouce.neriacorp.com
PUBLIC_API_URL=https://api.neriacorp.com
NERIACORP_PORTAL_URL=https://neriacorp.com
NERIACORP_PORTAL_STATUS=active
NERIACORP_PORTAL_SORT=10

# --- Paiements Stripe ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_POSTPARTUM=

# --- Email (Resend — domaine vérifié neriacorp.com ou *.neriacorp.com) ---
# Ne jamais mettre onboarding@resend.dev, @gmail.com ou @example.com ici.
RESEND_API_KEY=
SENDER_EMAIL=noreply@neriacorp.com
CONTACT_EMAIL=contact@mamandouce.neriacorp.com

# --- Chatbot / traduction (OPTIONNEL — pas utilisé par le scanner aliment) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_COMPLEX_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# --- Push VAPID ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=contact@neriacorp.com

# --- Cloudinary (nomenclature prod — secrets serveur uniquement) ---
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET
# python scripts/upload_fetus_cloudinary.py
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FETUS_FOLDER=mamandouce/fetus
CLOUDINARY_TRANSFORMS=f_auto,q_auto

# --- Scanner aliment : Gemini Vision (moteur Aevis / N2) ---
# Seul provider requis pour le scanner. Pas d'OpenAI ni d'OCR Worker.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Portail / Intelligence admin (optionnel — PAS requis par le scanner aliment) ---
N2_OCR_BASE_URL=https://api.neriacorp.com
N2_OCR_API_KEY=

# --- SSO portail NeriaCorp ---
# GET /api/neriacorp/sso/status expose toujours le handoff session (authorize/token/jwks)
# vers le Worker. sso_enabled=true seulement si ISSUER + LOGIN_URL sont tous les deux posés.
NERIACORP_SSO_ISSUER=
NERIACORP_SSO_LOGIN_URL=
NERIACORP_SSO_CALLBACK_URL=
NERIACORP_SSO_CLIENT_ID=mamandouce
# Prod (OAuth N2 Core) :
# NERIACORP_SSO_ISSUER=https://api.neriacorp.com
# NERIACORP_SSO_LOGIN_URL=https://api.neriacorp.com/api/auth/oauth/google/start
# NERIACORP_SSO_CALLBACK_URL=https://mamandouce.neriacorp.com/auth
# Publish live vers les apps sœurs (adapters.py)
AEVIS_BASE_URL=
AEVIS_API_KEY=
# VISATRACE_BASE_URL=
# VISATRACE_API_KEY=
# HERITIA_BASE_URL=
# HERITIA_API_KEY=
# HYSIA_BASE_URL=
# HYSIA_API_KEY=
# VEOVISION_BASE_URL=
# VEOVISION_API_KEY=
# VELLUMIA_BASE_URL=
# VELLUMIA_API_KEY=

# --- Divers ---
# PYTHONPATH propre (cwd = backend). Pas de package tiers hors site-packages.
PYTHONPATH=.
DEBUG=false
LOW_MEMORY_MODE=true
PORT=8000
# STORE_REVIEW_EMAIL=review@apple.com
# IS_CAMOUFLAGE_ACTIVE=true
# ADMIN_DASHBOARD_URL=https://mamandouce.neriacorp.com/admin
